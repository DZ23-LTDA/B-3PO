{
  "name": "b3po-app",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente B-3PO para Android e iOS (React Native). Cliente do runtime Hermes, nunca um segundo runtime.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease bundleRelease"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-keychain": "^9.2.0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
